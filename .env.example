# OpenAI / OpenRouter API Key for AI Verification Engine
OPENAI_API_KEY=your_openrouter_or_openai_api_key_here

# Optional: Configuration for Crawler
CONCURRENCY_LIMIT=5
TIMEOUT_SECONDS=30
RETRIES=3

# Optional: Default LLM Model to use (e.g. google/gemma-4-31b-it for OpenRouter)
DEFAULT_LLM_MODEL=google/gemma-4-31b-it
